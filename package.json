{
	"name": "tome-connector",
	"version": "1.1.1",
	"description": "Send note content from Obsidian to a Tome server via a configurable HTTP endpoint.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": "^22.13.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run --dir tests",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings=0 && node scripts/verify-function-sizes.mjs"
	},
	"keywords": [],
	"author": "Tome Gaming",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "5.0.5",
		"yaml": "^2.9.1"
	}
}
