{
	"name": "tome-connector",
	"version": "1.1.0",
	"description": "Send note content from Obsidian to a Tome server via a configurable HTTP endpoint.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run --dir tests",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings=0 && node scripts/verify-file-sizes.mjs && node scripts/verify-function-sizes.mjs"
	},
	"keywords": [],
	"author": "Tome Gaming",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.1",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	}
}
